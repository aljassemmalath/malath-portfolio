{
  "name": "malath-portfolio",
  "version": "1.0.0",
  "description": "Malath Aljassem — UI/UX Designer & Frontend Developer Portfolio",
  "author": "Malath Aljassem",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "sass": "sass sass/main.scss css/main.css --style=expanded --no-source-map",
    "sass:watch": "sass sass/main.scss css/main.css --watch --style=expanded --no-source-map",
    "sass:min": "sass sass/main.scss css/main.min.css --style=compressed --no-source-map",
    "build": "npm run sass:min"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.99.0"
  }
}
